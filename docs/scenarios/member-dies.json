{
  "title": "A member dies",
  "page": "failures/member-dies",
  "engines": {
    "vllm": {
      "pods": [
        {"name": "pod-0", "uid": "a1", "members": {"dp0": "serving"}},
        {"name": "pod-1", "uid": "b1", "members": {"dp1": "serving"}},
        {"name": "pod-2", "uid": "c1", "members": {"dp2": "serving"}},
        {"name": "pod-3", "uid": "d1", "members": {"dp3": "serving"}}
      ],
      "steps": [
        {
          "title": "The group serves",
          "phase": "serving",
          "internal": "Four DP ranks, one per Pod. Each holds its share of the experts and serves.",
          "calls": [
            {"to": "workload", "call": "Discover()", "out": "4 Pods, all Ready"},
            {
              "to": "driver",
              "call": "Observe(pods)",
              "out": "dp0 to dp3 serving",
              "requests": [
                {"call": "GET /v1/fault_tolerance/status", "in": "on dp0 to dp3", "out": "all healthy"},
                {"call": "GET /health", "in": "on dp0 to dp3", "out": "200"}
              ]
            },
            {"to": "policy", "call": "Plan(observation, admitted, candidates)", "out": "Healthy"}
          ],
          "journal": "serving · admitted dp0@idA dp1@idB dp2@idC dp3@idD"
        },
        {
          "title": "dp3 dies",
          "phase": "recovering",
          "pods": {"pod-0": {"dp0": "paused"}, "pod-1": {"dp1": "paused"}, "pod-2": {"dp2": "paused"}, "pod-3": {"dp3": "dead"}},
          "internal": "dp3's engine process exits. The survivors hit the fault, stop serving and wait for an instruction.",
          "calls": [
            {
              "to": "driver",
              "call": "Observe(pods)",
              "out": "dp3 terminal · dp0, dp1, dp2 paused",
              "requests": [
                {"call": "GET /v1/fault_tolerance/status", "in": "on dp0 to dp3", "out": "dp3 dead · dp0, dp1, dp2 unhealthy"},
                {"call": "GET /health", "in": "on dp0 to dp3", "out": "dp3: 503 · rest 200"}
              ]
            },
            {"to": "policy", "call": "Plan(observation, admitted, candidates)", "in": "admitted dp0 to dp3", "out": "Change: remove dp3@idD"}
          ]
        },
        {
          "title": "IRO saves the reconfig, then sends it",
          "note": "Saved first, so a new leader knows a reconfig may be running.",
          "phase": "recovering",
          "internal": "Every survivor must get the same request_id within 10 seconds. Each runs the instruction and re-forms as a group of 3.",
          "calls": [
            {"to": "journal", "call": "Save(record)", "in": "reconfig iro-ft-1: remove dp3@idD"},
            {
              "to": "driver",
              "call": "Apply(observation, reconfig)",
              "in": "iro-ft-1 to dp0, dp1, dp2",
              "out": "dp0, dp1, dp2 accept",
              "requests": [
                {"call": "POST /v1/fault_tolerance/apply", "in": "on dp0, dp1, dp2 · scale_down · removed_dp_ranks [3] · request_id iro-ft-1", "out": "202 · queued"}
              ]
            },
            {"to": "journal", "call": "Save(record)", "in": "acceptances of iro-ft-1"}
          ],
          "journal": "recovering · reconfig iro-ft-1 accepted by dp0 dp1 dp2"
        },
        {
          "title": "The group serves with 3 ranks",
          "phase": "serving",
          "pods": {"pod-3": {"dp3": "excluded"}},
          "internal": "The survivors hold every expert between them and serve again.",
          "calls": [
            {"to": "policy", "call": "Progress(observation, reconfig)", "out": "Succeeded"},
            {
              "to": "driver",
              "call": "Verify(observation, [dp0, dp1, dp2])",
              "out": "inference works",
              "requests": [
                {"call": "POST /v1/completions", "in": "\"One plus one equals\" · max_tokens 8", "out": "8 tokens each"}
              ]
            }
          ],
          "journal": "serving · admitted dp0@idA dp1@idB dp2@idC · excluded dp3@idD"
        },
        {
          "title": "Capacity stays short",
          "note": "vLLM cannot add a rank to a running group, so pod-3 is left as it is. The group serves with 3 until the next group; with --ft-capacity-restore=reset-all IRO resets the group instead.",
          "phase": "serving",
          "calls": [
            {"to": "driver", "call": "Capabilities()", "out": "Grow: no"},
            {"to": "controller", "call": "restore capacity", "in": "pod-3 holds only excluded members", "out": "no reset · dp3@idD rejected"}
          ],
          "journal": "serving · admitted dp0@idA dp1@idB dp2@idC · rejected dp3@idD"
        }
      ]
    }
  }
}
