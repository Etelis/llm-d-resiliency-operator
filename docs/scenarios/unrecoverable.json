{
  "title": "The engine cannot recover in place",
  "page": "failures/unrecoverable",
  "engines": {
    "vllm": {
      "pods": [
        {"name": "pod-0", "uid": "a1", "members": {"dp0": "serving"}},
        {"name": "pod-1", "uid": "b1", "members": {"dp1": "serving"}},
        {"name": "pod-2", "uid": "c1", "members": {"dp2": "serving"}},
        {"name": "pod-3", "uid": "d1", "members": {"dp3": "serving"}}
      ],
      "steps": [
        {
          "title": "The group serves",
          "phase": "serving",
          "calls": [{"to": "policy", "call": "Plan(...)", "out": "Healthy"}]
        },
        {
          "title": "Every rank dies",
          "note": "vLLM gives up in place only when no rank survives. Survivors that cannot hold every expert fail the scale_down instead, which is a reconfig failure.",
          "phase": "recovering",
          "pods": {"pod-0": {"dp0": "dead"}, "pod-1": {"dp1": "dead"}, "pod-2": {"dp2": "dead"}, "pod-3": {"dp3": "dead"}},
          "calls": [
            {"to": "engine", "call": "GET /v1/fault_tolerance/status · GET /health", "in": "on dp0 to dp3", "out": "all dead, /health 503"},
            {"to": "policy", "call": "Plan(...)", "out": "Unrecoverable: no rank survives"}
          ]
        },
        {
          "title": "IRO resets the whole group",
          "phase": "starting",
          "pods": {"pod-0": {"gone": true}, "pod-1": {"gone": true}, "pod-2": {"gone": true}, "pod-3": {"gone": true}},
          "calls": [
            {"to": "workload", "call": "ResetAll([pod-0 ... pod-3])", "in": "reason: unrecoverable", "out": "the whole group is recreated"}
          ]
        },
        {
          "title": "A new group serves",
          "phase": "serving",
          "pods": {"pod-0": {"uid": "a2", "dp0": "serving"}, "pod-1": {"uid": "b2", "dp1": "serving"}, "pod-2": {"uid": "c2", "dp2": "serving"}, "pod-3": {"uid": "d2", "dp3": "serving"}},
          "calls": [
            {"to": "workload", "call": "Discover()", "out": "4 new UIDs, none saved: a new group"},
            {"to": "policy", "call": "Plan(...)", "out": "Healthy"}
          ]
        }
      ]
    }
  }
}
