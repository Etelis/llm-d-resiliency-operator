{
  "title": "A reconfig fails",
  "page": "failures/reconfig-fails",
  "engines": {
    "vllm": {
      "pods": [
        {"name": "pod-0", "uid": "a1", "members": {"dp0": "serving"}},
        {"name": "pod-1", "uid": "b1", "members": {"dp1": "serving"}},
        {"name": "pod-2", "uid": "c1", "members": {"dp2": "serving"}},
        {"name": "pod-3", "uid": "d1", "members": {"dp3": "serving"}}
      ],
      "steps": [
        {
          "title": "dp3 dies",
          "phase": "recovering",
          "pods": {"pod-0": {"dp0": "paused"}, "pod-1": {"dp1": "paused"}, "pod-2": {"dp2": "paused"}, "pod-3": {"dp3": "dead"}},
          "calls": [{"to": "policy", "call": "Plan(...)", "out": "Change: remove dp3@idD"}]
        },
        {
          "title": "IRO sends the reconfig",
          "phase": "recovering",
          "calls": [
            {
              "to": "driver",
              "call": "Apply(observation, reconfig)",
              "in": "iro-ft-1: remove dp3",
              "out": "dp0, dp1, dp2 accept",
              "requests": [
                {"call": "POST /v1/fault_tolerance/apply", "in": "on dp0, dp1, dp2 · scale_down · removed_dp_ranks [3] · request_id iro-ft-1", "out": "202 · queued"}
              ]
            }
          ]
        },
        {
          "title": "dp1 fails while reconfiguring",
          "note": "The engine cannot promise the survivors are consistent, so the reconfig fails for the whole group.",
          "phase": "recovering",
          "pods": {"pod-1": {"dp1": "dead"}},
          "calls": [
            {
              "to": "driver",
              "call": "Observe(pods)",
              "out": "dp1 terminal · dp0, dp2 still recovering",
              "requests": [
                {"call": "GET /v1/fault_tolerance/status", "in": "on dp0 to dp2", "out": "dp1 dead · dp0, dp2 ft_state recovering, request iro-ft-1"},
                {"call": "GET /health", "in": "on dp0 to dp2", "out": "dp1: 503 · rest 200"}
              ]
            },
            {"to": "policy", "call": "Progress(observation, reconfig)", "out": "Failed, scope Group: dp1 died during the reconfig"}
          ]
        },
        {
          "title": "IRO resets the whole group",
          "phase": "starting",
          "pods": {"pod-0": {"gone": true}, "pod-1": {"gone": true}, "pod-2": {"gone": true}, "pod-3": {"gone": true}},
          "calls": [{"to": "workload", "call": "ResetAll([pod-0 ... pod-3])", "in": "reason: reconfig_failed", "out": "the whole group is recreated"}]
        },
        {
          "title": "A new group serves",
          "phase": "serving",
          "pods": {"pod-0": {"uid": "a2", "dp0": "serving"}, "pod-1": {"uid": "b2", "dp1": "serving"}, "pod-2": {"uid": "c2", "dp2": "serving"}, "pod-3": {"uid": "d2", "dp3": "serving"}},
          "calls": [{"to": "policy", "call": "Plan(...)", "out": "Healthy"}],
          "journal": "serving · admitted dp0@idA2 dp1@idB2 dp2@idC2 dp3@idD2"
        }
      ]
    }
  }
}
