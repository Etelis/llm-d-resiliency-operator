      "members": {
        "m1": "serving"
      }
    },
    {
      "name": "pod-2",
      "uid": "c1",
      "members": {
        "m2": "serving"
      }
    },
    {
      "name": "pod-3",
      "uid": "d1",
      "members": {
        "m3": "serving"
      }
    }
  ],
  "steps": [
    {
      "title": "m3 dies; IRO sends the reconfig",
      "phase": "recovering",
      "pods": {
        "pod-0": {
          "m0": "paused"
        },
        "pod-1": {
          "m1": "paused"
        },
        "pod-2": {
          "m2": "paused"
        },
        "pod-3": {
          "m3": "dead"
        }
      },
      "calls": [
        {
          "to": "driver",
          "call": "Apply(observation, reconfig)",
          "in": "iro-ft-1: remove m3",
          "out": "m0, m1, m2 accept"
        }
      ],
      "journal": "recovering \u00b7 reconfig iro-ft-1 since 10:00:05"
    },
    {
      "title": "It keeps running",
      "phase": "recovering",
      "calls": [
        {
          "to": "policy",
          "call": "Progress(...)",
          "out": "Running"
        }
      ]
    },
    {
      "title": "--ft-apply-timeout passes",
      "phase": "starting",
      "pods": {
        "pod-0": {
          "gone": true
        },
        "pod-1": {
          "gone": true
        },
        "pod-2": {
          "gone": true
        },
        "pod-3": {
          "gone": true
        }
      },
      "calls": [
        {
          "to": "workload",
          "call": "ResetAll([pod-0 ... pod-3])",
          "in": "reason: apply_deadline",
          "out": "the whole group is recreated"
        }
      ],
      "note": "90s by default, from when the reconfig was sent."
    },
    {
      "title": "A new group serves",
      "phase": "serving",
      "pods": {
        "pod-0": {
          "uid": "a2",
          "m0": "serving"
        },
        "pod-1": {
          "uid": "b2",
          "m1": "serving"
        },
        "pod-2": {
          "uid": "c2",
          "m2": "serving"
        },
        "pod-3": {
          "uid": "d2",
          "m3": "serving"
        }
      },
      "calls": [
        {
          "to": "workload",
          "call": "Discover()",
          "out": "4 new UIDs, none saved: a new group"
        },
        {
          "to": "policy",
          "call": "Plan(...)",
          "out": "Healthy"
        }
      ]
    }
