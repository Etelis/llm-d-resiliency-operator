{
  "title": "A member cannot be read",
  "page": "failures/member-unreadable",
  "engines": {
    "vllm": {
      "pods": [
        {"name": "pod-0", "uid": "a1", "members": {"dp0": "serving"}},
        {"name": "pod-1", "uid": "b1", "members": {"dp1": "serving"}},
        {"name": "pod-2", "uid": "c1", "members": {"dp2": "serving"}},
        {"name": "pod-3", "uid": "d1", "members": {"dp3": "serving"}}
      ],
      "steps": [
        {
          "title": "The group serves",
          "phase": "serving",
          "calls": [{"to": "policy", "call": "Plan(...)", "out": "Healthy"}]
        },
        {
          "title": "dp2's API stops answering",
          "note": "Its engine may still run and serve. IRO cannot tell, so dp2 is unknown: never serving, never terminal.",
          "phase": "recovering",
          "pods": {"pod-2": {"dp2": "unknown"}},
          "calls": [
            {
              "to": "driver",
              "call": "Observe(pods)",
              "out": "dp0, dp1, dp3 serving · dp2 unknown",
              "requests": [
                {"call": "GET /v1/fault_tolerance/status", "in": "on dp0 to dp3", "out": "dp0, dp1, dp3 healthy · dp2: timeout"},
                {"call": "GET /health", "in": "on dp0 to dp3", "out": "dp2: timeout · rest 200"}
              ]
            },
            {"to": "policy", "call": "Plan(...)", "out": "Healthy, but with dp2 unknown this counts as a fault"}
          ]
        },
        {
          "title": "IRO will not remove what it cannot see",
          "note": "Removing dp2 could break C1: the router may still send it traffic. A plan that names dp2 is not sent.",
          "phase": "recovering",
          "calls": [{"to": "policy", "call": "Plan(...)", "out": "Wait"}]
        },
        {
          "title": "dp2 stays unknown past --ft-diagnosis-timeout",
          "phase": "starting",
          "pods": {"pod-0": {"gone": true}, "pod-1": {"gone": true}, "pod-2": {"gone": true}, "pod-3": {"gone": true}},
          "calls": [
            {"to": "workload", "call": "ResetAll([pod-0 ... pod-3])", "in": "reason: diagnosis_deadline", "out": "the whole group is recreated"}
          ]
        },
        {
          "title": "A new group serves",
          "phase": "serving",
          "pods": {"pod-0": {"uid": "a2", "dp0": "serving"}, "pod-1": {"uid": "b2", "dp1": "serving"}, "pod-2": {"uid": "c2", "dp2": "serving"}, "pod-3": {"uid": "d2", "dp3": "serving"}},
          "calls": [
            {"to": "workload", "call": "Discover()", "out": "4 new UIDs, none saved: a new group"},
            {"to": "policy", "call": "Plan(...)", "out": "Healthy"}
          ]
        }
      ]
    }
  }
}
