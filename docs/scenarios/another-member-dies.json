{
  "title": "Another member dies after a shrink",
  "page": "failures/another-member-dies",
  "engines": {
    "vllm": {
      "pods": [
        {"name": "pod-0", "uid": "a1", "members": {"dp0": "serving"}},
        {"name": "pod-1", "uid": "b1", "members": {"dp1": "serving"}},
        {"name": "pod-2", "uid": "c1", "members": {"dp2": "serving"}},
        {"name": "pod-3", "uid": "d1", "members": {"dp3": "excluded"}}
      ],
      "steps": [
        {
          "title": "dp3 died and was removed",
          "phase": "serving",
          "calls": [
            {"to": "policy", "call": "Plan(...)", "out": "Healthy"}
          ],
          "journal": "serving · admitted dp0 dp1 dp2 · excluded dp3@idD"
        },
        {
          "title": "dp1 dies too",
          "phase": "recovering",
          "pods": {"pod-0": {"dp0": "paused"}, "pod-1": {"dp1": "dead"}, "pod-2": {"dp2": "paused"}},
          "calls": [
            {
              "to": "driver",
              "call": "Observe(pods)",
              "out": "dp1 terminal · dp0, dp2 paused · dp3 still excluded",
              "requests": [
                {"call": "GET /v1/fault_tolerance/status", "in": "on dp0 to dp2", "out": "dp1 dead · dp0, dp2 unhealthy"},
                {"call": "GET /health", "in": "on dp0 to dp2", "out": "dp1: 503 · rest 200"}
              ]
            },
            {"to": "policy", "call": "Plan(...)", "in": "admitted dp0, dp1, dp2", "out": "Change: remove dp1@idB"}
          ]
        },
        {
          "title": "A second reconfig removes dp1",
          "phase": "recovering",
          "calls": [
            {
              "to": "driver",
              "call": "Apply(observation, reconfig)",
              "in": "iro-ft-2 to dp0, dp2",
              "out": "dp0, dp2 accept",
              "requests": [
                {"call": "POST /v1/fault_tolerance/apply", "in": "on dp0, dp2 · scale_down · removed_dp_ranks [1] · request_id iro-ft-2", "out": "202 · queued"}
              ]
            }
          ]
        },
        {
          "title": "The group serves with 2 ranks",
          "phase": "serving",
          "pods": {"pod-0": {"dp0": "serving"}, "pod-1": {"dp1": "excluded"}, "pod-2": {"dp2": "serving"}},
          "calls": [
            {"to": "policy", "call": "Progress(...)", "out": "Succeeded"},
            {
              "to": "driver",
              "call": "Verify(observation, [dp0, dp2])",
              "out": "inference works",
              "requests": [
                {"call": "POST /v1/completions", "in": "\"One plus one equals\" · max_tokens 8", "out": "8 tokens each"}
              ]
            }
          ]
        },
        {
          "title": "Capacity stays short",
          "note": "vLLM cannot add ranks: both failed Pods stay as they are, their GPUs held until the next group. With --ft-capacity-restore=reset-all IRO resets the group instead.",
          "phase": "serving",
          "calls": [
            {"to": "driver", "call": "Capabilities()", "out": "Grow: no"},
            {"to": "controller", "call": "restore capacity", "in": "pod-1 and pod-3 hold only excluded members", "out": "no reset · dp1@idB, dp3@idD rejected"}
          ],
          "journal": "serving · admitted dp0@idA dp2@idC · rejected dp1@idB dp3@idD"
        }
      ]
    }
  }
}
