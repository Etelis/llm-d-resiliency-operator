{
  "title": "Two members die",
  "page": "failures/several-members-die",
  "engines": {
    "vllm": {
      "pods": [
        {"name": "pod-0", "uid": "a1", "members": {"dp0": "serving"}},
        {"name": "pod-1", "uid": "b1", "members": {"dp1": "serving"}},
        {"name": "pod-2", "uid": "c1", "members": {"dp2": "serving"}},
        {"name": "pod-3", "uid": "d1", "members": {"dp3": "serving"}}
      ],
      "steps": [
        {
          "title": "The group serves",
          "phase": "serving",
          "calls": [{"to": "policy", "call": "Plan(...)", "out": "Healthy"}]
        },
        {
          "title": "dp1 and dp3 die together",
          "phase": "recovering",
          "pods": {"pod-0": {"dp0": "paused"}, "pod-1": {"dp1": "dead"}, "pod-2": {"dp2": "paused"}, "pod-3": {"dp3": "dead"}},
          "calls": [
            {
              "to": "driver",
              "call": "Observe(pods)",
              "out": "dp1, dp3 terminal · dp0, dp2 paused",
              "requests": [
                {"call": "GET /v1/fault_tolerance/status", "in": "on dp0 to dp3", "out": "dp1, dp3 dead · dp0, dp2 unhealthy"},
                {"call": "GET /health", "in": "on dp0 to dp3", "out": "dp1, dp3: 503 · rest 200"}
              ]
            },
            {"to": "policy", "call": "Plan(...)", "out": "Change: remove dp1@idB and dp3@idD"}
          ]
        },
        {
          "title": "One reconfig removes both",
          "note": "Not one reconfig per death: the engine shrinks once.",
          "phase": "recovering",
          "calls": [
            {"to": "journal", "call": "Save(record)", "in": "reconfig iro-ft-1: remove dp1, dp3"},
            {
              "to": "driver",
              "call": "Apply(observation, reconfig)",
              "in": "iro-ft-1 to dp0, dp2",
              "out": "dp0, dp2 accept",
              "requests": [
                {"call": "POST /v1/fault_tolerance/apply", "in": "on dp0, dp2 · scale_down · removed_dp_ranks [1, 3] · request_id iro-ft-1", "out": "202 · queued"}
              ]
            }
          ]
        },
        {
          "title": "The group serves with 2 ranks",
          "phase": "serving",
          "pods": {"pod-0": {"dp0": "serving"}, "pod-1": {"dp1": "excluded"}, "pod-2": {"dp2": "serving"}, "pod-3": {"dp3": "excluded"}},
          "calls": [
            {"to": "policy", "call": "Progress(...)", "out": "Succeeded"},
            {
              "to": "driver",
              "call": "Verify(observation, [dp0, dp2])",
              "out": "inference works",
              "requests": [
                {"call": "POST /v1/completions", "in": "\"One plus one equals\" · max_tokens 8", "out": "8 tokens each"}
              ]
            }
          ]
        },
        {
          "title": "Capacity stays short",
          "note": "The removed ranks keep their GPUs; the group serves with 2 until the next group. With --ft-capacity-restore=reset-all IRO resets the group instead.",
          "phase": "serving",
          "calls": [
            {"to": "driver", "call": "Capabilities()", "out": "Grow: no"},
            {"to": "controller", "call": "restore capacity", "in": "pod-1 and pod-3 hold only excluded members", "out": "no reset · dp1@idB, dp3@idD rejected"}
          ],
          "journal": "serving · admitted dp0@idA dp2@idC · rejected dp1@idB dp3@idD"
        }
      ]
    }
  }
}
