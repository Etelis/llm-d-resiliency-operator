{
  "title": "The group cannot generate after a recovery",
  "page": "failures/verify-fails",
  "engines": {
    "vllm": {
      "pods": [
        {"name": "pod-0", "uid": "a1", "members": {"dp0": "serving"}},
        {"name": "pod-1", "uid": "b1", "members": {"dp1": "serving"}},
        {"name": "pod-2", "uid": "c1", "members": {"dp2": "serving"}},
        {"name": "pod-3", "uid": "d1", "members": {"dp3": "serving"}}
      ],
      "steps": [
        {
          "title": "A reconfig removed dp3 and succeeded",
          "phase": "serving",
          "pods": {"pod-3": {"dp3": "excluded"}},
          "calls": [
            {"to": "policy", "call": "Progress(...)", "out": "Succeeded"}
          ],
          "journal": "serving · verifying dp0 dp1 dp2"
        },
        {
          "title": "dp1 reports serving but cannot generate",
          "note": "One failed request is not a fault: IRO checks again every poll.",
          "phase": "serving",
          "calls": [
            {
              "to": "driver",
              "call": "Verify(observation, [dp0, dp1, dp2])",
              "out": "dp1: completion failed",
              "requests": [
                {"call": "POST /v1/completions", "in": "\"One plus one equals\" · max_tokens 8", "out": "dp1: generated 5 tokens, want 8"}
              ]
            }
          ]
        },
        {
          "title": "Still failing after --ft-verify-timeout",
          "phase": "starting",
          "pods": {"pod-0": {"gone": true}, "pod-1": {"gone": true}, "pod-2": {"gone": true}, "pod-3": {"gone": true}},
          "calls": [
            {"to": "workload", "call": "ResetAll([pod-0 ... pod-3])", "in": "reason: verify_failed", "out": "the whole group is recreated"}
          ],
          "note": "2m by default. In expert parallel every member takes part in every step, so no smaller action is safe."
        },
        {
          "title": "A new group serves",
          "phase": "serving",
          "pods": {"pod-0": {"uid": "a2", "dp0": "serving"}, "pod-1": {"uid": "b2", "dp1": "serving"}, "pod-2": {"uid": "c2", "dp2": "serving"}, "pod-3": {"uid": "d2", "dp3": "serving"}},
          "calls": [
            {"to": "workload", "call": "Discover()", "out": "4 new UIDs, none saved: a new group"},
            {"to": "policy", "call": "Plan(...)", "out": "Healthy"}
          ]
        }
      ]
    }
  }
}
