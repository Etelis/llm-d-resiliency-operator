            {
              "to": "driver",
              "call": "Observe(pods)",
              "out": "no admitted member could be read",
              "requests": [
                {"call": "GET /v1/fault_tolerance/status", "in": "on dp0 to dp3", "out": "timeout"},
                {"call": "GET /health", "in": "on dp0 to dp3", "out": "timeout"}
              ]
            }
          ],
          "journal": "serving · unseen since 10:12:33"
        },
        {
          "title": "Still unread after --ft-unseen-timeout",
          "note": "IRO cannot tell a blind spot of its own from a hung group, so after the timeout (10m by default) it resets. Only polls where Discover works count: IRO never resets a group the workload cannot list.",
