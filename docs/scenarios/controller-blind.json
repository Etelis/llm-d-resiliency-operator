          "pods": {"pod-0": {"gone": true}, "pod-1": {"gone": true}, "pod-2": {"gone": true}, "pod-3": {"gone": true}},
          "calls": [{"to": "workload", "call": "ResetAll([pod-0 ... pod-3])", "in": "reason: unseen", "out": "the whole group is recreated"}]
        },
        {
