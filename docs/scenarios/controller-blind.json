{
  "title": "IRO cannot see the group",
  "page": "failures/iro-blind",
  "engines": {
    "vllm": {
      "pods": [
        {"name": "pod-0", "uid": "a1", "members": {"dp0": "serving"}},
        {"name": "pod-1", "uid": "b1", "members": {"dp1": "serving"}},
        {"name": "pod-2", "uid": "c1", "members": {"dp2": "serving"}},
        {"name": "pod-3", "uid": "d1", "members": {"dp3": "serving"}}
      ],
      "steps": [
        {
          "title": "The group serves",
          "phase": "serving",
          "calls": [
            {
              "to": "driver",
              "call": "Observe(pods)",
              "out": "dp0 to dp3 serving",
              "requests": [
                {"call": "GET /v1/fault_tolerance/status", "in": "on dp0 to dp3", "out": "all healthy"},
                {"call": "GET /health", "in": "on dp0 to dp3", "out": "200"}
              ]
            }
          ]
        },
        {
          "title": "IRO cannot read any member",
          "note": "The network between IRO and the Pods breaks. The group itself may still serve. IRO opens no incident, plans nothing, and pauses its deadlines. If reads come back in time, nothing happens.",
