          "phase": "starting",
          "pods": {"pod-0": {"uid": "a2", "dp0": "starting"}, "pod-1": {"uid": "b2", "dp1": "starting"}, "pod-2": {"uid": "c2", "dp2": "starting"}, "pod-3": {"uid": "d2", "dp3": "starting"}},
          "calls": [{"to": "workload", "call": "Discover()", "out": "4 new UIDs, none saved: a new group"}],
          "journal": "starting · new group"
        },
        {
          "title": "Every member is up",
          "phase": "serving",
          "pods": {"pod-0": {"dp0": "serving"}, "pod-1": {"dp1": "serving"}, "pod-2": {"dp2": "serving"}, "pod-3": {"dp3": "serving"}},
          "calls": [{"to": "policy", "call": "Plan(...)", "out": "Healthy"}]
